# ============================================================
# 今日热搜 - Git 忽略文件（防止敏感/无用文件被上传到 GitHub）
# 规则：写在里面的文件和文件夹，git add 时会被自动跳过
# ============================================================

# ---------- 环境变量 / 密钥类（最重要！禁止上传）----------
.env
.env.*
*.env
!.env.example

# 各类密钥、证书、凭据文件
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.ppk
secrets/
credentials.json
service-account*.json

# ---------- 依赖目录（体积巨大，可随时重装，禁止上传）----------
node_modules/
bower_components/
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/

# 包管理缓存
.npm/
.pip/cache/

# ---------- 本地数据库文件（禁止上传）----------
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb
db.sqlite3
*.sql.local

# ---------- 构建产物 / 缓存 ----------
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
*.egg-info/

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 运行时 / 临时文件 ----------
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器 / IDE 本地配置 ----------
.idea/
.vscode/
*.code-workspace

# ---------- 测试 / 覆盖率报告 ----------
coverage/
.nyc_output/

# ---------- API 抓取的本地缓存数据（按需保留/调整）----------
data/cache/
*.cache.json

# ---------- 本地辅助小工具（只在本机用，不入仓库）----------
push.bat
